# 复制为 .env 后修改。敏感凭据只保存在本地，不要提交 Git。
HOST=127.0.0.1
PORT=8767
DATA_DIR=./data
TIMEZONE=Asia/Shanghai
AUTO_SCAN=1
# V1.1: SCAN_TIME 不再控制来源。刷新周期请到「设置 → 独立来源刷新策略」调整。
SCAN_DAYS=14
GITHUB_TOKEN=
# X 最近搜索通常需要开发者账户/额度，可产生费用。默认关闭。
X_ENABLED=0
X_BEARER_TOKEN=
X_QUERY=("AI agent" OR "MCP" OR "AI automation") -is:retweet lang:en
# OpenAI-compatible /chat/completions；支持按提供商文档配置百炼/火山/其他。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 部署到公网前必须增加认证、HTTPS、访问控制；默认仅本机监听。
