# 必须使用长随机值替换；至少32字节随机字符串
SECRET_KEY=replace-with-a-long-random-secret-before-deploy
# 本地Demo使用HTTP时保持0；HTTPS反向代理部署时改1
COOKIE_HTTPS_ONLY=0
# 本地Demo需要0；公网部署前必须改为1，并确保已创建自己的账户
DISABLE_DEMO_ACCOUNT=0
# 公网部署时建议设为 1，关闭公开注册；先创建好管理员账户再开启
# DISABLE_REGISTRATION=1
# openGym 动作库目录（可选）。留空时自动查找与本项目同级的 health/openGym。
# 只需要指向 openGym 根目录或它的 catalogue 目录；不需要启动 openGym 服务。
# OPEN_GYM_DIR=E:\health\openGym
